# EasyFile Analytics 密钥配置模板
#
# 使用说明：
# 1. 复制此文件为 .env.analytics（在同一目录下）
#    cp .env.analytics.example .env.analytics
#
# 2. 填入从各平台后台获取的实际密钥
#
# 3. 确保 .env.analytics 已添加到 .gitignore（不提交到代码库）
#
# 注意：此模板文件会提交到 Git，实际密钥文件不会

# =============================================================================
# 友盟（Umeng）密钥
# 获取地址：https://www.umeng.com/
# =============================================================================

# Android 应用的友盟 AppKey（32位字符串）
UMENG_ANDROID_KEY=YOUR_UMENG_ANDROID_KEY_HERE

# iOS 应用的友盟 AppKey（32位字符串）
# 注意：Android 和 iOS 的 AppKey 是不同的
UMENG_IOS_KEY=YOUR_UMENG_IOS_KEY_HERE

# =============================================================================
# Firebase 密钥（未来海外市场使用）
# 获取地址：https://console.firebase.google.com/
# =============================================================================

# Android 应用的 Firebase App ID
FIREBASE_ANDROID_APP_ID=YOUR_FIREBASE_ANDROID_APP_ID_HERE

# iOS 应用的 Firebase App ID
FIREBASE_IOS_APP_ID=YOUR_FIREBASE_IOS_APP_ID_HERE

# Firebase 项目 ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE

# =============================================================================
# 其他配置（可选）
# =============================================================================

# 自定义服务器地址（如需私有部署）
# ANALYTICS_SERVER_URL=https://your-custom-server.com
